## 2. Produtos RPG, do mais caro para o mais barato

SELECT nome, preco
FROM Produtos
WHERE categoria = 'RPG'
ORDER BY preco DESC;

## 3. Clientes e seus pedidos

SELECT c.nome, pe.id AS pedido_id, pr.nome AS produto, pe.quantidade
FROM Clientes c
LEFT JOIN Pedidos pe ON pe.cliente_id = c.id
LEFT JOIN Produtos pr ON pr.id = pe.produto_id
ORDER BY c.id, pe.id;

## 4. Total gasto por cliente

SELECT c.nome, COALESCE(SUM(pr.preco * pe.quantidade), 0) AS total_gasto
FROM Clientes c
LEFT JOIN Pedidos pe ON pe.cliente_id = c.id
LEFT JOIN Produtos pr ON pr.id = pe.produto_id
GROUP BY c.id, c.nome;

## 5. Categorias com preço médio acima de R$100

SELECT categoria, AVG(preco) AS preco_medio
FROM Produtos
GROUP BY categoria
HAVING AVG(preco) > 100;

## 6. Quantidade de pedidos por produto

SELECT pr.nome, COUNT(pe.id) AS total_pedidos
FROM Produtos pr
LEFT JOIN Pedidos pe ON pe.produto_id = pr.id
GROUP BY pr.id, pr.nome
ORDER BY total_pedidos DESC;
